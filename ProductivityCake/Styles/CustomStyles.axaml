<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!--  Add Controls for Previewer Here  -->
        </Border>
    </Design.PreviewWith>

    <!--  Add Styles Here  -->
    
    <!-- Global Font Family -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}" />
    </Style>
    
    <Style Selector="UserControl">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}" />
    </Style>
    
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}" />
    </Style>
    
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}" />
    </Style>
    
    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}" />
    </Style>
    
    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}" />
    </Style>
    
    <!--  Button Hover Effects  -->
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#7C3AED" />
    </Style>
    <!--    -->
    <!-- <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"> -->
    <!--     <Setter Property="Background" Value="#6D28D9" /> -->
    <!-- </Style> -->

    <!--  Specific Button Styles  -->

    <!--  Primary Action Buttons (Add, Save, etc.)  -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="#8B5CF6" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#A78BFA" />
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#7C3AED" />
    </Style>

    <!--  Secondary Buttons (Cancel, etc.)  -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="#3B82F6" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#60A5FA" />
    </Style>

    <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2563EB" />
    </Style>

    <!--  Danger Buttons (Delete)  -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#EF4444" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#F87171" />
    </Style>

    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#DC2626" />
    </Style>

    <!--  Transparent Buttons  -->
    <Style Selector="Button.transparent">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.transparent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#8B5CF620" />
    </Style>

    <Style Selector="Button.transparent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#8B5CF610" />
    </Style>

    <!--  Floating Action Button  -->
    <Style Selector="Button.fab">
        <Setter Property="Background" Value="#10B981" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="30" />
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="60" />
    </Style>

    <Style Selector="Button.fab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#34D399" />
    </Style>

    <Style Selector="Button.fab:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#059669" />
    </Style>

    <!--  Task Card Buttons  -->
    <Style Selector="Button.task-card">
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="BorderBrush" Value="#8B5CF640" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Button.task-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#334155" />
        <Setter Property="BorderBrush" Value="#8B5CF6" />
    </Style>

    <Style Selector="Button.task-card:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1E293B" />
    </Style>

    <!--  CheckBox Styling  -->
    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="#8B5CF6" />
        <Setter Property="Background" Value="#8B5CF620" />
    </Style>

    <Style Selector="CheckBox:pressed /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="#7C3AED" />
        <Setter Property="Background" Value="#8B5CF630" />
    </Style>

    <!--  ComboBox Styling  -->
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="#8B5CF6" />
    </Style>

    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="#A78BFA" />
    </Style>

    <!--  TextBox Styling  -->
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#8B5CF6" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#A78BFA" />
    </Style>

    <!--  Border Hover Effects (Self-rendering)  -->
    <Style Selector="Border.hoverable:pointerover">
        <Setter Property="Background" Value="#334155" />
    </Style>

    <Style Selector="Border.task-card:pointerover">
        <Setter Property="BorderBrush" Value="#8B5CF6" />
        <Setter Property="Background" Value="#334155" />
    </Style>

    <!--  Navigation Button Styling  -->
    <Style Selector="Button.nav-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.3" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.nav-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#25FFFFFF" Offset="0" />
                    <GradientStop Color="#15FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="Button.nav-button:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.05)" />
    </Style>
    
    <Style Selector="Button.nav-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#8B5CF640" Offset="0" />
                    <GradientStop Color="#A78BFA30" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="Button.nav-button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>

    <!--  Project Card Hover  -->
    <Style Selector="Button.project-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#334155" />
        <Setter Property="BorderBrush" Value="#8B5CF6" />
    </Style>

    <!--  Title Bar Button Styles  -->
    <Style Selector="Button#MinimizeButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#334155" />
    </Style>
    
    <Style Selector="Button#CloseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#EF444420" />
    </Style>
    
    <Style Selector="Button#CloseButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#EF4444" />
    </Style>

    <!-- ========== GLASSMORPHISM STYLES ========== -->
    
    <!-- Mode Selection Button Style -->
    <Style Selector="Button.mode-button">
        <Setter Property="Background" Value="#15FFFFFF" />
        <Setter Property="BorderBrush" Value="#30FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#B0FFFFFF" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
                <BrushTransition Property="Foreground" Duration="0:0:0.2" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Button.mode-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#25FFFFFF" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#50FFFFFF" />
    </Style>
    
    <Style Selector="Button.mode-button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#35FFFFFF" />
    </Style>
    
    <!-- Glass Card Style -->
    <Style Selector="Border.glass-card">
        <Setter Property="Background" Value="#15FFFFFF" />
        <Setter Property="BorderBrush" Value="#30FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="BoxShadow" Value="0 8 32 0 #20000000" />
    </Style>
    
    <!-- Glass Button Style -->
    <Style Selector="Button.glass-button">
        <Setter Property="Background" Value="#15FFFFFF" />
        <Setter Property="BorderBrush" Value="#30FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="50" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Button.glass-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#25FFFFFF" />
    </Style>
    
    <Style Selector="Button.glass-button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#35FFFFFF" />
        <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>
    
    <!-- Primary Glass Button (Play/Pause) -->
    <Style Selector="Button.glass-button-primary">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#10B981" Offset="0" />
                    <GradientStop Color="#059669" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="#50FFFFFF" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="50" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Button.glass-button-primary:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.05)" />
    </Style>
    
    <Style Selector="Button.glass-button-primary:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    
    <!-- Glass Tab Style -->
    <Style Selector="TabItem.glass-tab">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="Foreground" Value="#B0FFFFFF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="12,12,0,0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.3" />
                <BrushTransition Property="Foreground" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="TabItem.glass-tab:selected">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#15FFFFFF" />
    </Style>
    
    <Style Selector="TabItem.glass-tab:pointerover">
        <Setter Property="Foreground" Value="#E0FFFFFF" />
        <Setter Property="Background" Value="#10FFFFFF" />
    </Style>
    
    <!-- Glass Slider Style -->
    <Style Selector="Slider.glass-slider">
        <Setter Property="Foreground" Value="#10B981" />
    </Style>
    
    <Style Selector="Slider.glass-slider /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#10B981" Offset="0" />
                    <GradientStop Color="#34D399" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Slider.glass-slider /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#20FFFFFF" />
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Slider.glass-slider /template/ Thumb">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#10B981" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                <BrushTransition Property="Background" Duration="0:0:0.2" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    
    <!-- Slider Hover Effects -->
    <Style Selector="Slider.glass-slider:pointerover /template/ Thumb">
        <Setter Property="RenderTransform" Value="scale(1.15)" />
        <Setter Property="Background" Value="#10B981" />
        <Setter Property="BorderBrush" Value="White" />
    </Style>
    
    <Style Selector="Slider.glass-slider:pointerover /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#34D399" Offset="0" />
                    <GradientStop Color="#6EE7B7" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="Slider.glass-slider:pointerover /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="#30FFFFFF" />
    </Style>
    
    <!-- Slider Pressed Effects -->
    <Style Selector="Slider.glass-slider:pressed /template/ Thumb">
        <Setter Property="RenderTransform" Value="scale(1.05)" />
        <Setter Property="Background" Value="#059669" />
    </Style>
    
    <!-- Blue Slider Variant -->
    <Style Selector="Slider.glass-slider-blue /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#3B82F6" Offset="0" />
                    <GradientStop Color="#60A5FA" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="Slider.glass-slider-blue /template/ Thumb">
        <Setter Property="BorderBrush" Value="#3B82F6" />
    </Style>
    
    <Style Selector="Slider.glass-slider-blue:pointerover /template/ Thumb">
        <Setter Property="RenderTransform" Value="scale(1.15)" />
        <Setter Property="Background" Value="#3B82F6" />
        <Setter Property="BorderBrush" Value="White" />
    </Style>
    
    <Style Selector="Slider.glass-slider-blue:pointerover /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#60A5FA" Offset="0" />
                    <GradientStop Color="#93C5FD" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="Slider.glass-slider-blue:pressed /template/ Thumb">
        <Setter Property="RenderTransform" Value="scale(1.05)" />
        <Setter Property="Background" Value="#2563EB" />
    </Style>
    
    <!-- Purple Slider Variant -->
    <Style Selector="Slider.glass-slider-purple /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#A855F7" Offset="0" />
                    <GradientStop Color="#C084FC" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="Slider.glass-slider-purple /template/ Thumb">
        <Setter Property="BorderBrush" Value="#A855F7" />
    </Style>
    
    <Style Selector="Slider.glass-slider-purple:pointerover /template/ Thumb">
        <Setter Property="RenderTransform" Value="scale(1.15)" />
        <Setter Property="Background" Value="#A855F7" />
        <Setter Property="BorderBrush" Value="White" />
    </Style>
    
    <Style Selector="Slider.glass-slider-purple:pointerover /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#C084FC" Offset="0" />
                    <GradientStop Color="#E9D5FF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="Slider.glass-slider-purple:pressed /template/ Thumb">
        <Setter Property="RenderTransform" Value="scale(1.05)" />
        <Setter Property="Background" Value="#9333EA" />
    </Style>
    
    <!-- Glass ComboBox Style -->
    <Style Selector="ComboBox.glass-combo">
        <Setter Property="Background" Value="#15FFFFFF" />
        <Setter Property="BorderBrush" Value="#30FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="16,10" />
    </Style>
    
    <!-- Glass CheckBox Style -->
    <Style Selector="CheckBox.glass-checkbox">
        <Setter Property="Foreground" Value="White" />
    </Style>
    
    <Style Selector="CheckBox.glass-checkbox /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="#15FFFFFF" />
        <Setter Property="BorderBrush" Value="#30FFFFFF" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    
    <Style Selector="CheckBox.glass-checkbox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="#10B981" />
        <Setter Property="BorderBrush" Value="#10B981" />
    </Style>
    
    <!-- Stat Card Style -->
    <Style Selector="Border.stat-card">
        <Setter Property="Background" Value="#15FFFFFF" />
        <Setter Property="BorderBrush" Value="#30FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="10,16" />
        <Setter Property="BoxShadow" Value="0 4 16 0 #15000000" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Border.stat-card:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-2px)" />
        <Setter Property="BoxShadow" Value="0 8 24 0 #20000000" />
    </Style>
    
    <!-- Text Styles -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    
    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#B0FFFFFF" />
    </Style>
    
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#80FFFFFF" />
    </Style>

    <!-- TabItem Control Theme -->
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
        <Setter Property="FontSize" Value="{DynamicResource TabItemHeaderFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TabItemHeaderThemeFontWeight}" />
        <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundUnselected}" />
        <Setter Property="Foreground" Value="{DynamicResource TabItemHeaderForegroundUnselected}" />
        <Setter Property="Padding" Value="{DynamicResource TabItemHeaderMargin}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="{DynamicResource TabItemMinHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_LayoutRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <Panel>
                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                        <Border Name="PART_SelectedPipe"
                                Background="{DynamicResource TabItemHeaderSelectedPipeFill}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                IsVisible="False"/>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="RecognizesAccessKey" Value="True" />
        </Style>

        <!--  Selected state  -->
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundSelected}" />
            <Setter Property="Foreground" Value="{DynamicResource TabItemHeaderForegroundSelected}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!--  PointerOver state  -->
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundUnselectedPointerOver}" />
            <Setter Property="Foreground" Value="{DynamicResource TabItemHeaderForegroundUnselectedPointerOver}" />
        </Style>

        <!--  Selected PointerOver state  -->
        <Style Selector="^:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundSelectedPointerOver}" />
            <Setter Property="Foreground" Value="{DynamicResource TabItemHeaderForegroundSelectedPointerOver}" />
        </Style>

        <!--  Pressed state  -->
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundUnselectedPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource TabItemHeaderForegroundUnselectedPressed}" />
        </Style>

        <!--  Selected Pressed state  -->
        <Style Selector="^:selected:pressed">
            <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundSelectedPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource TabItemHeaderForegroundSelectedPressed}" />
        </Style>

        <!--  Disabled state  -->
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundDisabled}" />
            <Setter Property="Foreground" Value="{DynamicResource TabItemHeaderForegroundDisabled}" />
        </Style>

        <!--  TabStripPlacement States Group  -->
        <Style Selector="^[TabStripPlacement=Left] /template/ Border#PART_SelectedPipe">
            <Setter Property="Width" Value="{DynamicResource TabItemPipeThickness}" />
            <Setter Property="Height" Value="{DynamicResource TabItemVerticalPipeHeight}" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^[TabStripPlacement=Left] /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style Selector="^[TabStripPlacement=Top] /template/ Border#PART_SelectedPipe, ^[TabStripPlacement=Bottom] /template/ Border#PART_SelectedPipe">
            <Setter Property="Height" Value="{DynamicResource TabItemPipeThickness}" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style Selector="^[TabStripPlacement=Right] /template/ Border#PART_SelectedPipe">
            <Setter Property="Width" Value="{DynamicResource TabItemPipeThickness}" />
            <Setter Property="Height" Value="{DynamicResource TabItemVerticalPipeHeight}" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^[TabStripPlacement=Right] /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style Selector="^[TabStripPlacement=Right]">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </ControlTheme>
    </Styles.Resources>

</Styles>
