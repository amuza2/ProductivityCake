<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="ProductivityCake.Views.ProjectListView"
    x:DataType="vm:ProjectListViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ProductivityCake.Models"
    xmlns:vm="using:ProductivityCake.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.DataContext>
        <vm:ProjectListViewModel />
    </Design.DataContext>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#132a13" Offset="0" />
                <GradientStop Color="#1a3a1a" Offset="0.5" />
                <GradientStop Color="#132a13" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <!--  Main Content  -->
        <Grid RowDefinitions="Auto, *">
            <!--  Header  -->
            <Border
                Background="#15FFFFFF"
                BorderBrush="#30FFFFFF"
                BorderThickness="0,0,0,1"
                Grid.Row="0"
                Padding="20,20,20,15">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="White"
                        Grid.Column="0"
                        Text="Projects"
                        VerticalAlignment="Center" />

                    <!--  Archive Toggle Button  -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Classes="secondary"
                            Command="{Binding ToggleShowArchivedCommand}"
                            IsVisible="{Binding !ShowArchived}"
                            Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontSize="14" Text="Show Archived" />
                            </StackPanel>
                        </Button>
                        <Button
                            Classes="secondary"
                            Command="{Binding ToggleShowArchivedCommand}"
                            IsVisible="{Binding ShowArchived}"
                            Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontSize="14" Text="Show Active" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Projects List  -->
            <ScrollViewer Background="Transparent" Grid.Row="1">
                <Grid Margin="20,20,20,100">
                    <!--  Empty State  -->
                    <Border
                        HorizontalAlignment="Center"
                        IsVisible="{Binding !HasProjects}"
                        Padding="40"
                        VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Spacing="20">
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                Foreground="#D1D5DB"
                                HorizontalAlignment="Center"
                                Text="No Projects Yet" />
                            <TextBlock
                                FontSize="14"
                                Foreground="#9CA3AF"
                                HorizontalAlignment="Center"
                                MaxWidth="300"
                                Text="Create your first project to get started!"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                Classes="primary"
                                Command="{Binding OpenAddProjectDialogCommand}"
                                Content="Create Project"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0"
                                Padding="20,10" />
                        </StackPanel>
                    </Border>

                    <!--  Projects List  -->
                    <ItemsControl IsVisible="{Binding HasProjects}" ItemsSource="{Binding DisplayedProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:Project">
                                <Button
                                    Background="#20FFFFFF"
                                    BorderBrush="#30FFFFFF"
                                    BorderThickness="1"
                                    Classes="project-card"
                                    Command="{Binding $parent[ItemsControl].((vm:ProjectListViewModel)DataContext).OpenProjectDetailsCommand}"
                                    CommandParameter="{Binding}"
                                    CornerRadius="16"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,12"
                                    Padding="18">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}" />

                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#9CA3AF"
                                                IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap" />

                                            <!--  Task Counts  -->
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Border
                                                    Background="#31572c"
                                                    CornerRadius="3"
                                                    Padding="6,3">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        Text="{Binding TodoTasksCount, StringFormat='To Do: {0}'}" />
                                                </Border>
                                                <Border
                                                    Background="#90a955"
                                                    CornerRadius="3"
                                                    Padding="6,3">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        Text="{Binding DoingTasksCount, StringFormat='Doing: {0}'}" />
                                                </Border>
                                                <Border
                                                    Background="#4f772d"
                                                    CornerRadius="3"
                                                    Padding="6,3">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        Text="{Binding DoneTasksCount, StringFormat='Done: {0}'}" />
                                                </Border>
                                            </StackPanel>

                                            <!--  Project Stats  -->
                                            <StackPanel Orientation="Horizontal" Spacing="15">
                                                <!--  Completion Percentage  -->
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="#9CA3AF"
                                                        Text="📊" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="#90a955"
                                                        Text="{Binding CompletionPercentage, StringFormat={}{0}% Complete}" />
                                                </StackPanel>

                                                <!--  Last Updated  -->
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#6B7280"
                                                    IsVisible="{Binding LastUpdated, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                    Text="{Binding LastUpdated, StringFormat='Updated: {0:MMM dd, yyyy}'}" />
                                            </StackPanel>

                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#6B7280"
                                                Text="{Binding CreatedAt, StringFormat='Created: {0:MMM dd, yyyy}'}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="5"
                                            VerticalAlignment="Center">
                                            <!--  Archive Button (Active Projects Only)  -->
                                            <Button
                                                Classes="secondary"
                                                Command="{Binding $parent[ItemsControl].((vm:ProjectListViewModel)DataContext).ArchiveProjectCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding !IsArchived}"
                                                Padding="10,5"
                                                ToolTip.Tip="Archive this project">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontSize="12" Text="Archive" />
                                                </StackPanel>
                                            </Button>

                                            <!--  Unarchive Button (Archived Projects Only)  -->
                                            <Button
                                                Classes="secondary"
                                                Command="{Binding $parent[ItemsControl].((vm:ProjectListViewModel)DataContext).UnarchiveProjectCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsArchived}"
                                                Padding="10,5"
                                                ToolTip.Tip="Restore this project">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontSize="12" Text="Unarchive" />
                                                </StackPanel>
                                            </Button>

                                            <!--  Delete Button (Archived Projects Only)  -->
                                            <Button
                                                Classes="danger"
                                                Command="{Binding $parent[ItemsControl].((vm:ProjectListViewModel)DataContext).ShowDeleteConfirmationCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsArchived}"
                                                Padding="10,5"
                                                ToolTip.Tip="Permanently delete this project">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontSize="12" Text="🗑️" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!--  Floating Add Button  -->
        <Button
            Classes="fab"
            Command="{Binding OpenAddProjectDialogCommand}"
            HorizontalAlignment="Right"
            HorizontalContentAlignment="Center"
            Margin="20"
            VerticalAlignment="Bottom"
            VerticalContentAlignment="Center">
            <TextBlock
                FontSize="32"
                FontWeight="Light"
                Text="+" />
        </Button>

        <!--  Add Project Dialog  -->
        <Border
            Background="#90000000"
            IsVisible="{Binding IsAddProjectDialogOpen}"
            ZIndex="100">
            <Border
                Background="#45FFFFFF"
                BorderBrush="#50FFFFFF"
                BorderThickness="1"
                CornerRadius="20"
                HorizontalAlignment="Center"
                MaxWidth="450"
                Padding="30,25"
                VerticalAlignment="Center"
                BoxShadow="0 20 60 0 #40000000">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Classes="title"
                            FontSize="22"
                            Text="Add New Project" />
                        <TextBlock
                            Classes="subtitle"
                            FontSize="13"
                            Text="Create a new project to organize your tasks" />
                    </StackPanel>

                    <StackPanel Spacing="15">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Classes="label"
                                FontSize="12"
                                Text="Project Name" />
                            <TextBox
                                Classes="glass-combo"
                                Text="{Binding NewProjectName}"
                                Watermark="Enter project name..." />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock
                                Classes="label"
                                FontSize="12"
                                Text="Description (Optional)" />
                            <TextBox
                                AcceptsReturn="True"
                                Classes="glass-combo"
                                Height="90"
                                Text="{Binding NewProjectDescription}"
                                TextWrapping="Wrap"
                                Watermark="Add a description..." />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            Classes="glass-button"
                            Command="{Binding CancelAddProjectCommand}"
                            Content="Cancel"
                            Padding="24,10"
                            Width="100" />
                        <Button
                            Classes="glass-button-primary"
                            Command="{Binding AddProjectCommand}"
                            Content="✓ Add"
                            Padding="24,10"
                            Width="100" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!--  Delete Confirmation Dialog  -->
        <Border
            Background="#90000000"
            IsVisible="{Binding IsDeleteConfirmationOpen}"
            ZIndex="100">
            <Border
                Classes="glass-card"
                HorizontalAlignment="Center"
                MaxWidth="450"
                Padding="30,25"
                VerticalAlignment="Center"
                BoxShadow="0 20 60 0 #40000000">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Classes="title"
                            FontSize="22"
                            Foreground="#EF4444"
                            Text="⚠️ Delete Project?" />
                        <TextBlock
                            Classes="subtitle"
                            FontSize="13"
                            Text="This action cannot be undone" />
                    </StackPanel>

                    <Border
                        Background="#15EF4444"
                        BorderBrush="#30EF4444"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Classes="subtitle"
                                FontSize="13"
                                Text="You are about to permanently delete:" />
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding ProjectToDelete.Name}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Classes="label"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        Text="All tasks and data will be lost forever"
                        TextWrapping="Wrap" />

                    <StackPanel
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            Classes="glass-button"
                            Command="{Binding CancelDeleteCommand}"
                            Content="Cancel"
                            Padding="24,10"
                            Width="110" />
                        <Button
                            Background="#EF4444"
                            BorderBrush="#50FFFFFF"
                            BorderThickness="1"
                            Command="{Binding ConfirmDeleteCommand}"
                            Content="🗑️ Delete"
                            CornerRadius="50"
                            Cursor="Hand"
                            Foreground="White"
                            Padding="24,10"
                            Width="110">
                            <Button.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                                </Transitions>
                            </Button.Transitions>
                            <Button.Styles>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="RenderTransform" Value="scale(1.05)" />
                                </Style>
                                <Style Selector="Button:pressed">
                                    <Setter Property="RenderTransform" Value="scale(0.98)" />
                                </Style>
                            </Button.Styles>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>

</UserControl>
