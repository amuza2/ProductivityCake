<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"

    x:Class="ProductivityCake.Views.TimerView"
    x:DataType="vm:TimerViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:converter="using:ProductivityCake.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ProductivityCake.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <converter:BoolToStartPauseConverter x:Key="IconConverter" PlayText="▶" PauseText="⏸" />
    </UserControl.Resources>

    <Design.DataContext>
        <vm:TimerViewModel />
    </Design.DataContext>

    <!-- Gradient Background -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#0F172A" Offset="0" />
                <GradientStop Color="#1E293B" Offset="0.5" />
                <GradientStop Color="#0F172A" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <TabControl Margin="5,0,5,5" TabStripPlacement="Top">
            <TabControl.Styles>
                <Style Selector="TabControl">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="TabControl WrapPanel">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </TabControl.Styles>

            <!--  Timer Tab  -->
            <TabItem Classes="glass-tab" Header="Timer">
                <StackPanel Margin="20,10,20,20" Spacing="15">
                    <!--  Timer Display  -->
                    <Border Classes="glass-card" Padding="30,20" HorizontalAlignment="Center">
                        <StackPanel Spacing="10">
                            <!--  Timer State  -->
                            <TextBlock
                                FontSize="18"
                                FontWeight="Medium"
                                HorizontalAlignment="Center"
                                Text="{Binding StateDisplayName}">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding CurrentState, Converter={StaticResource TimerStateToColorConverter}}" />
                                </TextBlock.Foreground>
                            </TextBlock>

                            <!--  Circular Progress with Time  -->
                            <Grid
                                Height="200"
                                HorizontalAlignment="Center"
                                Width="200"
                                Margin="0,5,0,5">
                                <!--  Outer Glow  -->
                                <Ellipse
                                    Height="220"
                                    Width="220"
                                    Opacity="0.3">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <RadialGradientBrush.GradientStops>
                                                <GradientStop Color="{Binding CurrentState, Converter={StaticResource TimerStateToColorConverter}}" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </RadialGradientBrush.GradientStops>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!--  Background Circle  -->
                                <Arc
                                    Height="200"
                                    StartAngle="-90"
                                    Stroke="#20FFFFFF"
                                    StrokeThickness="12"
                                    SweepAngle="360"
                                    Width="200" />

                                <!--  Progress Arc  -->
                                <Arc
                                    Height="200"
                                    StartAngle="-90"
                                    StrokeLineCap="Round"
                                    StrokeThickness="12"
                                    SweepAngle="{Binding Progress, Converter={StaticResource ProgressToAngleConverter}}"
                                    Width="200">
                                    <Arc.Stroke>
                                        <SolidColorBrush Color="{Binding CurrentState, Converter={StaticResource TimerStateToColorConverter}}" />
                                    </Arc.Stroke>
                                    <Arc.Effect>
                                        <DropShadowEffect Color="{Binding CurrentState, Converter={StaticResource TimerStateToColorConverter}}" 
                                                         BlurRadius="20" 
                                                         Opacity="0.6" />
                                    </Arc.Effect>
                                </Arc>

                                <!--  Time Display in Center  -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        FontFamily="Segoe UI,Arial"
                                        FontSize="52"
                                        FontWeight="Light"
                                        Foreground="White"
                                        HorizontalAlignment="Center"
                                        Text="{Binding TimeDisplay}"
                                        Opacity="0.95" />
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="Medium"
                                        Foreground="#70FFFFFF"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0"
                                        Text="remaining" />
                                </StackPanel>
                            </Grid>

                            <!--  Current Session  -->
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="#90FFFFFF"
                                HorizontalAlignment="Center"
                                Text="{Binding CurrentSessionDisplay}" />
                        </StackPanel>
                    </Border>

                    <!--  Control Buttons  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0"
                        Orientation="Horizontal"
                        Spacing="20">
                        <!--  Reset Button  -->
                        <Button
                            Classes="glass-button"
                            Command="{Binding ResetTimerCommand}"
                            Height="64"
                            ToolTip.Tip="Reset Timer"
                            Width="64">
                            <TextBlock
                                FontSize="28"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                Text="↻"
                                VerticalAlignment="Center" />
                        </Button>

                        <!--  Start/Pause Button (Larger)  -->
                        <Button
                            Classes="glass-button-primary"
                            Command="{Binding ToggleTimerCommand}"
                            Height="80"
                            ToolTip.Tip="{Binding IsRunning, Converter={StaticResource BoolToStartPauseConverter}}"
                            Width="80">
                            <TextBlock
                                FontSize="36"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                Text="{Binding IsRunning, Converter={StaticResource IconConverter}}"
                                VerticalAlignment="Center" />
                        </Button>

                        <!--  Skip Button  -->
                        <Button
                            Classes="glass-button"
                            Command="{Binding SkipSessionCommand}"
                            Height="64"
                            ToolTip.Tip="Skip to Next Session"
                            Width="64">
                            <TextBlock
                                FontSize="28"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                Text="⏭"
                                VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!--  Statistics Tab  -->
            <TabItem Classes="glass-tab" Header="Statistics">
                <ScrollViewer>
                    <StackPanel Margin="15" Spacing="10">
                        <!--  Statistics Cards  -->
                        <StackPanel Spacing="10">
                            <!--  Labels Row  -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                <TextBlock
                                    Classes="label"
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    Text="Today" />
                                <TextBlock
                                    Classes="label"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Text="This Week" />
                                <TextBlock
                                    Classes="label"
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    Text="{Binding CurrentMonthName}" />
                            </Grid>

                            <!--  Time Studied Row  -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                <Border Classes="stat-card" Grid.Column="0">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="#90FFFFFF"
                                        HorizontalAlignment="Center"
                                        Text="{Binding TodayTimeDisplay}" />
                                </Border>

                                <Border Classes="stat-card" Grid.Column="1">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="#90FFFFFF"
                                        HorizontalAlignment="Center"
                                        Text="{Binding WeekTimeDisplay}" />
                                </Border>

                                <Border Classes="stat-card" Grid.Column="2">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="#90FFFFFF"
                                        HorizontalAlignment="Center"
                                        Text="{Binding MonthTimeDisplay}" />
                                </Border>
                            </Grid>

                            <!--  Sessions Count Row  -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                <Border Classes="stat-card" Grid.Column="0">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="20"
                                            FontWeight="Medium"
                                            Foreground="#90FFFFFF"
                                            HorizontalAlignment="Center"
                                            Text="{Binding TodaySessionsDisplay}" />
                                        <TextBlock
                                            Classes="label"
                                            FontSize="15"
                                            HorizontalAlignment="Center"
                                            Text="sessions" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="stat-card" Grid.Column="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="20"
                                            FontWeight="Medium"
                                            Foreground="#90FFFFFF"
                                            HorizontalAlignment="Center"
                                            Text="{Binding WeekSessionsDisplay}" />
                                        <TextBlock
                                            Classes="label"
                                            FontSize="15"
                                            HorizontalAlignment="Center"
                                            Text="sessions" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="stat-card" Grid.Column="2">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="20"
                                            FontWeight="Medium"
                                            Foreground="#90FFFFFF"
                                            HorizontalAlignment="Center"
                                            Text="{Binding MonthSessionsDisplay}" />
                                        <TextBlock
                                            Classes="label"
                                            FontSize="15"
                                            HorizontalAlignment="Center"
                                            Text="sessions" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!--  Activity Heatmap  -->
                        <Border Classes="glass-card" Padding="25,20">
                            <StackPanel Spacing="20">
                                <TextBlock
                                    Classes="title"
                                    Text="Activity Heatmap" />
                                
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="8" Margin="0,0,0,20">
                                        <!--  Month Labels  -->
                                        <ItemsControl ItemsSource="{Binding HeatmapMonths}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="30,0,0,0" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Classes="label"
                                                        Text="{Binding MonthName}"
                                                        Width="{Binding Width}"
                                                        Margin="0,0,3,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!--  Heatmap Grid with Day Labels  -->
                                        <Grid ColumnDefinitions="Auto,*">
                                            <!--  Day Labels (Y-axis)  -->
                                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,8,0">
                                                <TextBlock Height="14" />
                                                <TextBlock Classes="label" Text="Mon" Height="14" />
                                                <TextBlock Height="14" />
                                                <TextBlock Classes="label" Text="Wed" Height="14" />
                                                <TextBlock Height="14" />
                                                <TextBlock Classes="label" Text="Fri" Height="14" />
                                                <TextBlock Height="14" />
                                            </StackPanel>
                                            
                                            <!--  Heatmap Squares  -->
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding HeatmapWeeks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="3" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ItemsControl ItemsSource="{Binding Days}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Spacing="3" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border
                                                                        Width="14"
                                                                        Height="14"
                                                                        Background="{Binding Color}"
                                                                        CornerRadius="3"
                                                                        ToolTip.Tip="{Binding Tooltip}">
                                                                        <Border.Transitions>
                                                                            <Transitions>
                                                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                                                                            </Transitions>
                                                                        </Border.Transitions>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                                
                                <!--  Legend  -->
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                    <TextBlock Classes="label" Text="Less" VerticalAlignment="Center" />
                                    <Border Width="14" Height="14" Background="#20FFFFFF" CornerRadius="3" />
                                    <Border Width="14" Height="14" Background="#0E4429" CornerRadius="3" />
                                    <Border Width="14" Height="14" Background="#006D32" CornerRadius="3" />
                                    <Border Width="14" Height="14" Background="#26A641" CornerRadius="3" />
                                    <Border Width="14" Height="14" Background="#39D353" CornerRadius="3" />
                                    <TextBlock Classes="label" Text="More" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  Settings Tab  -->
            <TabItem Classes="glass-tab" Header="Settings">
                <ScrollViewer>
                    <StackPanel Margin="20" Spacing="20">

                        <!--  Timer Settings  -->
                        <Border Classes="glass-card" Padding="30,25">
                            <StackPanel Spacing="25">
                                <TextBlock Classes="title" Text="⏱️ Timer Settings" />

                                <!--  Work Time  -->
                                <StackPanel Spacing="15">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Classes="subtitle"
                                            Grid.Column="0"
                                            Text="Work Time"
                                            VerticalAlignment="Center" />
                                        <Border
                                            Background="#20FFFFFF"
                                            BorderBrush="#30FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Grid.Column="1"
                                            Padding="16,8">
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding WorkSessionMinutes, StringFormat='{}{0} min'}" />
                                        </Border>
                                    </Grid>
                                    
                                    <Slider
                                        Classes="glass-slider"
                                        IsSnapToTickEnabled="True"
                                        Maximum="90"
                                        Minimum="1"
                                        TickFrequency="1"
                                        Value="{Binding WorkSessionMinutes}" />
                                    
                                    <Grid ColumnDefinitions="*,*,*">
                                        <TextBlock Classes="label" Grid.Column="0" HorizontalAlignment="Left" Text="1 min" />
                                        <TextBlock Classes="label" Grid.Column="1" HorizontalAlignment="Center" Text="45 min" />
                                        <TextBlock Classes="label" Grid.Column="2" HorizontalAlignment="Right" Text="90 min" />
                                    </Grid>
                                </StackPanel>

                                <!--  Short Break Time  -->
                                <StackPanel Spacing="15">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Classes="subtitle"
                                            Grid.Column="0"
                                            Text="Short Break Time"
                                            VerticalAlignment="Center" />
                                        <Border
                                            Background="#20FFFFFF"
                                            BorderBrush="#30FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Grid.Column="1"
                                            Padding="16,8">
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding ShortBreakMinutes, StringFormat='{}{0} min'}" />
                                        </Border>
                                    </Grid>
                                    
                                    <Slider
                                        Classes="glass-slider glass-slider-blue"
                                        IsSnapToTickEnabled="True"
                                        Maximum="30"
                                        Minimum="1"
                                        TickFrequency="1"
                                        Value="{Binding ShortBreakMinutes}" />
                                    
                                    <Grid ColumnDefinitions="*,*,*">
                                        <TextBlock Classes="label" Grid.Column="0" HorizontalAlignment="Left" Text="1 min" />
                                        <TextBlock Classes="label" Grid.Column="1" HorizontalAlignment="Center" Text="15 min" />
                                        <TextBlock Classes="label" Grid.Column="2" HorizontalAlignment="Right" Text="30 min" />
                                    </Grid>
                                </StackPanel>

                                <!--  Long Break Time  -->
                                <StackPanel Spacing="15">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Classes="subtitle"
                                            Grid.Column="0"
                                            Text="Long Break Time"
                                            VerticalAlignment="Center" />
                                        <Border
                                            Background="#20FFFFFF"
                                            BorderBrush="#30FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Grid.Column="1"
                                            Padding="16,8">
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{Binding LongBreakMinutes, StringFormat='{}{0} min'}" />
                                        </Border>
                                    </Grid>
                                    
                                    <Slider
                                        Classes="glass-slider glass-slider-purple"
                                        IsSnapToTickEnabled="True"
                                        Maximum="60"
                                        Minimum="1"
                                        TickFrequency="1"
                                        Value="{Binding LongBreakMinutes}" />
                                    
                                    <Grid ColumnDefinitions="*,*,*">
                                        <TextBlock Classes="label" Grid.Column="0" HorizontalAlignment="Left" Text="1 min" />
                                        <TextBlock Classes="label" Grid.Column="1" HorizontalAlignment="Center" Text="30 min" />
                                        <TextBlock Classes="label" Grid.Column="2" HorizontalAlignment="Right" Text="60 min" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Notifications  -->
                        <Border Classes="glass-card" Padding="30,25">
                            <StackPanel Spacing="18">
                                <TextBlock Classes="title" Text="🔔 Notifications" />

                                <CheckBox
                                    Classes="glass-checkbox"
                                    Content="Enable desktop notifications"
                                    FontSize="14"
                                    IsChecked="{Binding NotificationsEnabled}" />

                                <TextBlock
                                    Classes="label"
                                    Text="Get notified when your timer completes"
                                    TextWrapping="Wrap" />

                                <Button
                                    Classes="glass-button"
                                    Command="{Binding StartTestTimerCommand}"
                                    Content="🔔 Test Sound (5s)"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0"
                                    Padding="20,12"
                                    ToolTip.Tip="Start a 5-second timer to test sound notification"
                                    Width="200" />
                            </StackPanel>
                        </Border>

                        <!--  Window Settings  -->
                        <Border Classes="glass-card" Padding="30,25">
                            <StackPanel Spacing="18">
                                <TextBlock Classes="title" Text="🪟 Window Settings" />

                                <CheckBox
                                    Classes="glass-checkbox"
                                    Content="Always on top"
                                    FontSize="14"
                                    IsChecked="{Binding AlwaysOnTop}" />

                                <TextBlock
                                    Classes="label"
                                    Text="Keep the window above all other windows"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!--  About  -->
                        <Border Classes="glass-card" Padding="30,25">
                            <StackPanel Spacing="18">
                                <TextBlock Classes="title" Text="About" />

                                <TextBlock
                                    Classes="subtitle"
                                    Text="ProductivityCake - A simple Pomodoro timer"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Classes="label"
                                    Text="Version 1.1.0"
                                    HorizontalAlignment="Center"
                                    Margin="0,5,0,0" />

                                <Button
                                    Classes="glass-button-primary"
                                    Command="{Binding OpenGitHubCommand}"
                                    Content="⭐ Star it on GitHub"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0"
                                    Padding="20,12"
                                    ToolTip.Tip="Support the project on GitHub"
                                    Width="220" />
                            </StackPanel>
                        </Border>
                
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
