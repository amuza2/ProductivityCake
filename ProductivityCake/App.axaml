<Application
    RequestedThemeVariant="Dark"
    x:Class="ProductivityCake.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:converter="using:ProductivityCake.Converters"
    xmlns:local="using:ProductivityCake"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options.  -->

    <Application.Resources>
        <!-- Font Families -->
        <!-- Kufi Regular for Arabic with Liberation Sans fallback (includes Bold, Italic, BoldItalic variants) -->
        <FontFamily x:Key="DefaultFont">avares://ProductivityCake/Assets#Kufi Regular, avares://ProductivityCake/Assets#Liberation Sans</FontFamily>
        <FontFamily x:Key="ArabicFont">avares://ProductivityCake/Assets#Kufi Regular</FontFamily>
        <FontFamily x:Key="LatinFont">avares://ProductivityCake/Assets#Liberation Sans</FontFamily>
        <converter:DueDateConverter x:Key="DueDateConverter" />
        <converter:DueDateToColorConverter x:Key="DueDateToColorConverter" />
        <converter:BoolToStartPauseConverter x:Key="BoolToStartPauseConverter" />
        <converter:BoolToExpanderConverter x:Key="BoolToExpanderConverter" />
        <converter:ContainsItemConverter x:Key="ContainsItemConverter" />
        <converter:TimerStateToColorConverter x:Key="TimerStateToColorConverter" />
        <converter:ProgressToAngleConverter x:Key="ProgressToAngleConverter" />
        <converter:BoolToThicknessConverter x:Key="BoolToThicknessConverter" />
        <converter:BoolToBorderBrushConverter x:Key="WorkBorderBrushConverter" ActiveColor="#4f772d" />
        <converter:BoolToBorderBrushConverter x:Key="LongWorkBorderBrushConverter" ActiveColor="#31572c" />
        <converter:BoolToBorderBrushConverter x:Key="ShortBreakBorderBrushConverter" ActiveColor="#90a955" />
        <converter:BoolToBorderBrushConverter x:Key="LongBreakBorderBrushConverter" ActiveColor="#ecf39e" />
    </Application.Resources>


    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Assets/Icons.axaml" />
        <StyleInclude Source="Styles/CustomStyles.axaml" />
    </Application.Styles>
</Application>